#!/bin/sh
# System defaults — hostname, MOTD, skel permissions.
set -e

echo "==> Setting defaults"

echo "nebula" > /etc/hostname
sed -i '/^127.0.1.1/d' /etc/hosts
echo "127.0.1.1 nebula" >> /etc/hosts

# MOTD
cat >/etc/motd <<'EOF'

  Nebula Agent Edition
  --------------------
  Local-first AI desktop, powered by Nova + Ollama.

  Type `nebula-agent` to launch the agent.
  Open Nova in your browser at http://127.0.0.1:5757 once it's running.

EOF

# Make sure the skel autostart dir permissions carry over
if [ -d /etc/skel/.config ]; then
    chmod -R 755 /etc/skel/.config
fi
