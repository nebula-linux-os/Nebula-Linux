#!/bin/bash
# nebula — Nebula Linux control center CLI.
set -u

PUR='\e[1;35m'; DIM='\e[2m'; OFF='\e[0m'

banner() { printf "${PUR}Nebula Linux${OFF} — %s\n\n" "$1"; }

have_snapper() { command -v snapper >/dev/null && snapper --no-dbus list-configs 2>/dev/null | grep -q '^root'; }

cmd_update() {
    banner "system update"
    if have_snapper; then
        echo "snap-pac will create pre/post snapshots automatically."
    fi
    sudo pacman -Syu
    if command -v flatpak >/dev/null && flatpak remotes 2>/dev/null | grep -q .; then
        echo; echo ">> Updating Flatpaks..."
        flatpak update -y --noninteractive || true
    fi
}

cmd_snapshots() {
    banner "snapshots"
    if have_snapper; then
        snapper list
    else
        echo "Snapper is not configured (this system may not use btrfs)."
        echo "Snapshots are set up automatically on btrfs installs."
    fi
}

cmd_rollback() {
    banner "rollback"
    if ! have_snapper; then
        echo "Snapper is not configured — nothing to roll back to."; exit 1
    fi
    if [[ $# -lt 1 ]]; then
        snapper list
        echo
        echo "Usage: nebula rollback <snapshot-number>"
        echo "Rolls the root filesystem back to that snapshot, then reboot."
        echo "Tip: you can also boot old snapshots directly from the GRUB menu."
        exit 0
    fi
    sudo snapper rollback "$1" && echo "Rolled back. Reboot to use the restored system."
}

cmd_drivers() {
    banner "hardware / drivers"
    virt=$(systemd-detect-virt 2>/dev/null || echo none)
    if [[ "$virt" != "none" ]]; then
        echo "Virtual machine detected: $virt (guest tools auto-start at boot)."
    fi
    gpus=$(lspci 2>/dev/null | grep -Ei 'vga|3d|display' || true)
    echo "GPU(s):"
    echo "${gpus:-  none detected}"
    echo
    if grep -qi nvidia <<<"$gpus"; then
        echo "NVIDIA GPU found. Install the proprietary driver with:"
        echo "    nebula drivers install-nvidia"
    elif grep -qiE 'amd|ati' <<<"$gpus"; then
        echo "AMD GPU: open-source Mesa drivers are already installed."
    elif grep -qi intel <<<"$gpus"; then
        echo "Intel GPU: open-source Mesa drivers are already installed."
    fi
    if [[ "${1:-}" == "install-nvidia" ]]; then
        sudo pacman -S --needed nvidia nvidia-utils lib32-nvidia-utils 2>/dev/null \
            || sudo pacman -S --needed nvidia nvidia-utils
        echo "Reboot to load the NVIDIA driver."
    fi
}

cmd_doctor() {
    banner "doctor"
    echo "── Failed services ──────────────────────────"
    systemctl --failed --no-pager --no-legend || true
    echo
    echo "── Disk usage ───────────────────────────────"
    df -h / /home 2>/dev/null | grep -v '^Filesystem' || true
    echo
    echo "── Last system update ───────────────────────"
    grep -E 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -1 || echo "no record"
    echo
    if command -v dms >/dev/null; then
        echo "── DankMaterialShell doctor ─────────────────"
        dms doctor 2>/dev/null || true
    fi
}

cmd_windows() {
    banner "window mode"
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
    [[ -f "$cfg" ]] || { echo "niri config not found: $cfg"; exit 1; }
    if ! grep -q 'NEBULA-WINDOW-MODE-START' "$cfg"; then
        echo "This config has no managed window-mode block; edit it manually."; exit 1
    fi
    local mode="${1:-status}"
    case "$mode" in
        floating|tiling)
            local tmp
            tmp=$(mktemp)
            awk -v mode="$mode" '
                /NEBULA-WINDOW-MODE-START/ {
                    print; inblock=1
                    if (mode == "floating") {
                        print "// Floating mode: new windows open floating (classic desktop)."
                        print "window-rule {"
                        print "    open-floating true"
                        print "}"
                    } else {
                        print "// Tiling mode: windows tile into scrollable columns (default)."
                    }
                    next
                }
                /NEBULA-WINDOW-MODE-END/ { inblock=0; print; next }
                inblock { next }
                { print }
            ' "$cfg" > "$tmp" && mv "$tmp" "$cfg"
            echo "Window mode set to: $mode (applies immediately — niri reloads its config)."
            echo "Tip: Super+Shift+Space toggles any single window between modes."
            ;;
        status|*)
            if sed -n '/NEBULA-WINDOW-MODE-START/,/NEBULA-WINDOW-MODE-END/p' "$cfg" | grep -q 'open-floating true'; then
                echo "Current mode: floating (classic windows)"
            else
                echo "Current mode: tiling (scrollable columns, default)"
            fi
            echo "Usage: nebula windows <tiling|floating>"
            ;;
    esac
}

cmd_wallpaper() {
    banner "wallpaper & theme"
    local manifest=/usr/share/backgrounds/nebula/themes/themes.json
    local themes_dir=/usr/share/backgrounds/nebula/themes
    [[ -f "$manifest" ]] || { echo "themes manifest missing: $manifest"; exit 1; }

    local action="${1:-current}"
    case "$action" in
        list)
            printf "${DIM}Bundled Nebula themes:${OFF}\n\n"
            python3 -c '
import json
m = json.load(open("'"$manifest"'"))
for t in m["themes"]:
    tag = " (default)" if t["id"] == m["default"] else ""
    print(f"  {t[\"id\"]:<16}  {t[\"name\"]}{tag}")
    print(f"  {\"\":<16}  {t[\"tagline\"]}  [{t[\"mode\"]}]")
    print()
print("Usage: nebula wallpaper set <id>       apply a bundled theme")
print("       nebula wallpaper set <path>     apply an arbitrary image file")
'
            ;;
        set)
            local target="${2:-}"
            [[ -z "$target" ]] && { echo "Usage: nebula wallpaper set <id-or-path>"; exit 1; }
            local wp
            if [[ -f "$themes_dir/$target.png" ]]; then
                wp="$themes_dir/$target.png"
            elif [[ -f "$target" ]]; then
                wp="$(readlink -f "$target")"
            else
                echo "No such theme or file: $target"
                echo "Try:  nebula wallpaper list"
                exit 1
            fi
            echo "Applying wallpaper: $wp"

            # DMS's session.json is the source of truth — DMS watches it and
            # re-derives the whole Material palette when wallpaperPath changes.
            local dms_state="$HOME/.local/state/DankMaterialShell"
            local dms_json="$dms_state/session.json"
            mkdir -p "$dms_state"
            [[ -f "$dms_json" ]] || echo '{}' > "$dms_json"
            python3 - "$dms_json" "$wp" <<'PY' && echo "  ✓ DMS session.json updated (wallpaper + lock screen)"
import json, sys
path, wp = sys.argv[1], sys.argv[2]
try:
    with open(path) as f: data = json.load(f)
except Exception:
    data = {}
data["wallpaperPath"] = wp
data["lockScreenWallpaperPath"] = wp
data.setdefault("wallpaperFillMode", "PreserveAspectCrop")
with open(path, "w") as f: json.dump(data, f, indent=2)
PY

            # If DMS is running, nudge it to reload immediately. Different DMS
            # builds expose different IPC verbs — try a few, don't require any.
            if command -v dms >/dev/null; then
                for verb in "wallpapers set" "wallpaper set" "theme reload" "settings reload"; do
                    dms ipc call $verb "$wp" >/dev/null 2>&1 && break
                done
            fi

            # Persist the choice for scripts / next login.
            mkdir -p "$HOME/.config/nebula"
            printf '%s\n' "$wp" > "$HOME/.config/nebula/wallpaper.path"
            echo "Theme applied. If DMS was already running, the palette retunes within a second or two."
            ;;
        current)
            if [[ -r "$HOME/.config/nebula/wallpaper.path" ]]; then
                cat "$HOME/.config/nebula/wallpaper.path"
            else
                python3 -c '
import json
m = json.load(open("'"$manifest"'"))
print("'"$themes_dir"'/" + m["default"] + ".png  (default)")
'
            fi
            ;;
        *)
            echo "Usage: nebula wallpaper <list|set <id-or-path>|current>"
            ;;
    esac
}

cmd_bugreport() {
    banner "bug report"
    local tmp
    tmp=$(mktemp -d)
    local report="$tmp/report.md"
    {
        echo "### Environment"
        echo
        echo '```'
        . /etc/os-release 2>/dev/null && printf 'Distro:  %s %s\n' "$NAME" "$VERSION"
        echo    "Kernel:  $(uname -sr)"
        echo    "CPU:     $(lscpu 2>/dev/null | awk -F: '/Model name/ {sub(/^ +/,"",$2); print $2; exit}')"
        echo    "Memory:  $(free -h | awk '/^Mem:/ {print $2}')"
        echo    "GPU:     $(lspci 2>/dev/null | grep -Ei 'vga|3d|display' | sed 's/^[0-9a-f:.]* //' | paste -sd '; ')"
        virt=$(systemd-detect-virt 2>/dev/null || echo none)
        echo    "Virt:    $virt"
        if command -v dms >/dev/null; then
            echo "DMS:     $(dms --version 2>/dev/null || echo unknown)"
        fi
        if command -v niri >/dev/null; then
            echo "niri:    $(niri --version 2>/dev/null | head -1)"
        fi
        echo '```'
        echo
        echo "### Failed services"
        echo
        echo '```'
        systemctl --failed --no-pager --no-legend 2>/dev/null || echo "(none)"
        echo '```'
        echo
        echo "### Recent pacman errors"
        echo
        echo '```'
        grep -iE 'error|failed' /var/log/pacman.log 2>/dev/null | tail -15 || echo "(no log)"
        echo '```'
        echo
        echo "### What went wrong?"
        echo
        echo "<!-- Describe what you were doing and what you expected. -->"
        echo
        echo "### Steps to reproduce"
        echo
        echo "1."
        echo "2."
    } > "$report"

    echo "Report written: $report"
    echo
    cat "$report"
    echo
    if [[ "${1:-}" == "--open" ]]; then
        local title="[bug] "
        # URL-encode the report body (very light: enough for GitHub's ?body=).
        local body
        body=$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.stdin.read()))' < "$report")
        local url="https://github.com/nebula-linux-os/Nebula-Linux/issues/new?title=$(python3 -c 'import urllib.parse; print(urllib.parse.quote("'"$title"'"))')&body=$body"
        echo "Opening browser..."
        xdg-open "$url" >/dev/null 2>&1 || echo "Could not open browser. Visit: $url"
    else
        echo "Tip: 'nebula bugreport --open' pre-fills a GitHub issue in your browser."
    fi
}

cmd_greeter() {
    banner "login greeter"
    case "${1:-}" in
        dms)
            src=/usr/share/quickshell/dms/Modules/Greetd/assets/dms-greeter
            [[ -f "$src" ]] || { echo "dms-greeter asset not found."; exit 1; }
            sudo install -Dm755 "$src" /usr/local/bin/dms-greeter
            sudo mkdir -p /var/cache/dms-greeter
            sudo chown greeter:greeter /var/cache/dms-greeter 2>/dev/null || true
            sudo tee /etc/greetd/config.toml >/dev/null <<'EOF'
[terminal]
vt = 1

[default_session]
command = "dms-greeter --command niri"
user = "greeter"
EOF
            echo "Switched to the DMS graphical greeter (takes effect next boot)."
            echo "If it misbehaves: Ctrl+Alt+F3, log in, run: nebula greeter text"
            ;;
        text)
            sudo tee /etc/greetd/config.toml >/dev/null <<'EOF'
[terminal]
vt = 1

[default_session]
command = "agreety --cmd niri-session"
user = "greeter"
EOF
            echo "Switched to the text greeter (takes effect next boot)."
            ;;
        *)
            echo "Usage: nebula greeter <dms|text>"
            ;;
    esac
}

case "${1:-help}" in
    update)    shift; cmd_update "$@" ;;
    snapshots) shift; cmd_snapshots "$@" ;;
    rollback)  shift; cmd_rollback "$@" ;;
    drivers)   shift; cmd_drivers "$@" ;;
    doctor)    shift; cmd_doctor "$@" ;;
    greeter)   shift; cmd_greeter "$@" ;;
    windows)   shift; cmd_windows "$@" ;;
    wallpaper|theme) shift; cmd_wallpaper "$@" ;;
    bugreport) shift; cmd_bugreport "$@" ;;
    *)
        printf "${PUR}nebula${OFF} — Nebula Linux control center\n\n"
        echo "  nebula update                 update system (auto-snapshots on btrfs)"
        echo "  nebula snapshots              list filesystem snapshots"
        echo "  nebula rollback [N]           roll back to snapshot N"
        echo "  nebula drivers                detect hardware, suggest drivers"
        echo "  nebula drivers install-nvidia install NVIDIA driver"
        echo "  nebula doctor                 health check"
        echo "  nebula greeter <dms|text>     switch login screen style"
        echo "  nebula windows <tiling|floating>  tiled columns or classic floating windows"
        echo "  nebula wallpaper list         list bundled Nebula themes"
        echo "  nebula wallpaper set <id>     apply a theme (retunes matugen palette)"
        echo "  nebula bugreport [--open]     collect system info, optionally open GitHub issue"
        ;;
esac
