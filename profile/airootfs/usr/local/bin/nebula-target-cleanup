#!/bin/bash
# Runs inside the installed system (chroot) via Calamares' shellprocess module,
# after unpackfs copied the live image. Strips live-only pieces and finishes
# system setup. Must never hard-fail: partial cleanup beats a failed install.
set -u

echo "nebula-target-cleanup: removing live-session pieces"
rm -f /etc/systemd/system/multi-user.target.wants/nebula-live-setup.service
rm -f /etc/systemd/system/nebula-live-setup.service
rm -f /usr/local/bin/nebula-live-setup
rm -f /etc/sudoers.d/10-nebula-live
rm -f /etc/polkit-1/rules.d/49-nebula-live.rules
rm -f /usr/share/applications/install-nebula.desktop
rm -f /usr/local/bin/nebula-installer
rm -f /usr/local/bin/nebula-install

# The greetd package's sysusers.d config leaves the "greeter" system user
# with HOME=/ (filesystem root) rather than a real home directory. Every
# write dms-greeter/Quickshell attempts relative to $HOME (config, cache,
# state dirs) would fail against a root-owned "/" — fix it to the
# standard, ArchWiki-recommended greeter home.
if id greeter >/dev/null 2>&1; then
    mkdir -p /var/lib/greeter
    chown greeter:greeter /var/lib/greeter
    usermod -d /var/lib/greeter greeter 2>/dev/null || true
fi

# Real login instead of live autologin: DMS graphical greeter when available,
# text greeter otherwise. (Switch any time with: nebula greeter <dms|text>)
DMS_GREETER_SRC=/usr/share/quickshell/dms/Modules/Greetd/assets/dms-greeter
if [[ -f "$DMS_GREETER_SRC" ]]; then
    install -Dm755 "$DMS_GREETER_SRC" /usr/local/bin/dms-greeter

    # dms-greeter's locate_dms_config() looks for a Quickshell config
    # directory literally named "dms-greeter" (/usr/share/quickshell/
    # dms-greeter/shell.qml), but the package only ships the real shell.qml
    # under "dms" (/usr/share/quickshell/dms/shell.qml) — a naming mismatch
    # between what the greeter script expects and what the package provides.
    # Without this, dms-greeter's config lookup fails, its `set -e` causes
    # an immediate silent exit (code 1, zero output), and greetd just
    # restarts it in a loop until systemd's start-limit-hit kills it —
    # observed as an indefinite hang on the Plymouth splash with no error
    # ever reaching the console. Confirmed via bash -x trace on a real
    # install. A symlink is enough; it also survives dms-shell package
    # updates naturally since it just points at whatever "dms" contains.
    if [[ ! -e /usr/share/quickshell/dms-greeter ]]; then
        ln -s /usr/share/quickshell/dms /usr/share/quickshell/dms-greeter
    fi

    mkdir -p /var/cache/dms-greeter
    cat > /var/cache/dms-greeter/session.json <<'EOF'
{
  "wallpaperPath": "/usr/share/backgrounds/nebula/nebula.png",
  "wallpaperFillMode": "PreserveAspectCrop"
}
EOF
    chown -R greeter:greeter /var/cache/dms-greeter 2>/dev/null || true
    cat > /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[default_session]
command = "dms-greeter --command niri"
user = "greeter"
EOF
else
    cat > /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[default_session]
command = "agreety --cmd niri-session"
user = "greeter"
EOF
fi

# Friendly MOTD for installed systems.
cat > /etc/motd <<'EOF'

    Welcome to Nebula Linux.
    Docs: https://danklinux.com/docs/    Keybindings: Super+Shift+/

EOF

echo "nebula-target-cleanup: removing archiso live machinery"
# Must happen BEFORE the initcpio module regenerates the initramfs.
pacman -Rns --noconfirm mkinitcpio-archiso 2>/dev/null || true
rm -f /etc/mkinitcpio.conf.d/archiso.conf

# archiso's releng profile overwrites /etc/mkinitcpio.d/linux.preset with a
# live-only version (PRESETS=('archiso'), pointing at archiso.conf and
# /run/archiso paths). unpackfs copies the whole live filesystem verbatim,
# so the installed target inherits this same broken preset. Uninstalling
# mkinitcpio-archiso does NOT restore it — archiso's build process writes
# this file directly, it isn't owned/reinstallable via that package. Must
# be restored to the standard linux-package preset BEFORE Calamares' own
# "initcpio" module runs mkinitcpio -P, or that module fails with
# "Invalid option -k -- '/boot/vmlinuz-linux' must be readable" (it's
# trying to use archiso.conf's expectations against a normal install).
cat > /etc/mkinitcpio.d/linux.preset <<'EOF'
# mkinitcpio preset file for the 'linux' package

#ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

#default_config="/etc/mkinitcpio.conf"
default_image="/boot/initramfs-linux.img"
#default_options=""

#fallback_config="/etc/mkinitcpio.conf"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

rm -f /etc/systemd/system/choose-mirror.service
rm -f /etc/systemd/system/pacman-init.service
rm -f /etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f /etc/systemd/system/multi-user.target.wants/choose-mirror.service
rm -f /etc/systemd/system/multi-user.target.wants/pacman-init.service

# archiso strips /boot/vmlinuz-linux from the airootfs squashfs — the live
# kernel is served from the ISO's own boot directory, not from inside the
# squashfs, so the copied-out target has an EMPTY /boot. That breaks two
# things: (1) mkinitcpio's preset reads the kernel version from
# ALL_kver=/boot/vmlinuz-linux and fails "must be readable"; (2) more
# importantly, GRUB needs /boot/vmlinuz-linux to boot the installed system
# at all. Restore it exactly the way the linux package's own ALPM install
# hook does: copy /usr/lib/modules/<kver>/vmlinuz to /boot/vmlinuz-<pkgbase>.
# Must run BEFORE Calamares' initcpio module.
echo "nebula-target-cleanup: restoring kernel image(s) into /boot"
for kdir in /usr/lib/modules/*/; do
    [[ -f "${kdir}vmlinuz" ]] || continue
    if [[ -f "${kdir}pkgbase" ]]; then
        pkgbase=$(<"${kdir}pkgbase")
    else
        pkgbase=linux
    fi
    install -Dm644 "${kdir}vmlinuz" "/boot/vmlinuz-${pkgbase}"
    echo "  restored /boot/vmlinuz-${pkgbase} from ${kdir}vmlinuz"
done

# The installer itself does not belong on the installed system.
pacman -Rns --noconfirm calamares 2>/dev/null || true

echo "nebula-target-cleanup: GRUB theme + background"
if ! grep -q '^GRUB_BACKGROUND=' /etc/default/grub 2>/dev/null; then
    echo 'GRUB_BACKGROUND="/usr/share/backgrounds/nebula/nebula-grub.png"' >> /etc/default/grub
fi
if [[ -f /usr/share/grub/themes/nebula/theme.txt ]]; then
    if ! grep -q '^GRUB_THEME=' /etc/default/grub 2>/dev/null; then
        echo 'GRUB_THEME="/usr/share/grub/themes/nebula/theme.txt"' >> /etc/default/grub
    fi
    sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="Nebula Linux"|' /etc/default/grub 2>/dev/null || true
    # Regenerate grub.cfg so the theme is picked up on next boot.
    grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
fi

echo "nebula-target-cleanup: enabling Plymouth first-boot setup"
# We deliberately do NOT touch mkinitcpio.conf or run plymouth-set-default-theme
# in this shellprocess stage — Calamares' initcpio module runs mkinitcpio
# immediately after this script, and adding the plymouth hook here caused
# it to fail. Instead, a systemd oneshot service (nebula-plymouth-setup)
# runs on the installed system's very first boot, where mkinitcpio has
# proper /proc access and can regenerate the initramfs safely.
systemctl enable nebula-plymouth-setup.service >/dev/null 2>&1 || true

echo "nebula-target-cleanup: snapshots & maintenance"
# Snapshot/rollback stack — only when the root filesystem is btrfs.
if findmnt -n -o FSTYPE / 2>/dev/null | grep -q btrfs; then
    if command -v snapper >/dev/null && ! snapper --no-dbus list-configs 2>/dev/null | grep -q '^root'; then
        snapper --no-dbus -c root create-config / || true
        # snap-pac drives pacman pre/post snapshots; keep timeline snapshots modest.
        sed -i -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
               -e 's/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/' \
               /etc/snapper/configs/root 2>/dev/null || true
    fi
    systemctl enable snapper-cleanup.timer >/dev/null 2>&1 || true
    # Boot old snapshots straight from the GRUB menu.
    systemctl enable grub-btrfsd.service >/dev/null 2>&1 || true
fi
systemctl enable fstrim.timer >/dev/null 2>&1 || true

echo "nebula-target-cleanup: initializing pacman keyring (may take a moment)"
pacman-key --init >/dev/null 2>&1 || true
pacman-key --populate archlinux >/dev/null 2>&1 || true

systemctl set-default graphical.target >/dev/null 2>&1 || true

echo "nebula-target-cleanup: done"
exit 0
